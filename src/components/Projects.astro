---
import Section from './Section.astro'
import { Image } from 'astro:assets'
import type { ProjectProps } from '@types'

interface Props {
	projects: ProjectProps[]
}

const { projects } = Astro.props
const [featured, ...others] = projects
---

<Section
	text='Things I’ve built & helped build'
	href='projects'
	class='px-4 pt-20 pb-10 md:px-14'
>
	<div class='grid gap-5 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]'>
		{featured && (
			<article class='flex flex-col overflow-hidden rounded-[28px] bg-surface'>
				<Image
					class={`mx-3.5 mt-3.5 aspect-[736/483] h-auto w-[calc(100%-1.75rem)] rounded-[18px] bg-placeholder object-cover ${featured.centerImage ? 'object-center' : 'object-left-top'}`}
					src={featured.image}
					alt={featured.imageAlt ?? `${featured.name} screenshot`}
					width='736'
					height='483'
				/>
				<div class='flex flex-col gap-3 px-6 pt-6 pb-7 md:px-7 md:pb-[30px]'>
					{featured.label && (
						<p class='text-[13px] font-semibold text-coral'>{featured.label}</p>
					)}
					<h3 class='text-[34px] leading-tight font-semibold tracking-[-1px]'>
						{featured.name}
					</h3>
					<p class='text-[17px] leading-[1.55] text-ink-muted'>
						{featured.summary}
					</p>
					<ul class='flex flex-wrap gap-1.5' role='list'>
						{featured.technologies.map((tech) => (
							<li class='rounded-full bg-chip px-[11px] py-[5px] text-[13px] text-chip-ink'>
								{tech}
							</li>
						))}
					</ul>
					<div class='mt-1 flex flex-wrap gap-x-[18px] gap-y-2 text-[15px] font-semibold text-coral'>
						{featured.links?.map(({ href, text }) => (
							<a
								href={href}
								target='_blank'
								rel='noopener noreferrer'
								class='-my-1.5 inline-block py-1.5'
							>
								{text} <span class='sr-only'>for {featured.name}</span>
								<span aria-hidden='true'>→</span>
								<span class='sr-only'>(opens in new tab)</span>
							</a>
						))}
					</div>
				</div>
			</article>
		)}
		<div class='flex flex-col gap-5'>
			{others.map(({ name, summary, image, imageAlt, links }) => (
				<article class='grid flex-1 grid-cols-[80px_minmax(0,1fr)] gap-4 rounded-3xl bg-surface p-3.5 sm:grid-cols-[112px_minmax(0,1fr)] sm:gap-[18px]'>
					<Image
						class='aspect-square h-auto w-full rounded-[14px] bg-placeholder object-cover'
						src={image}
						alt={imageAlt ?? `${name} logo`}
						width='112'
						height='112'
					/>
					<div class='flex flex-col gap-1.5 py-1 pr-2'>
						<h3 class='text-xl font-semibold tracking-[-0.3px]'>{name}</h3>
						<p class='text-sm leading-normal text-ink-muted'>{summary}</p>
						{links?.[0] && (
							<a
								href={links[0].href}
								target='_blank'
								rel='noopener noreferrer'
								class='-my-1.5 self-start py-1.5 text-sm font-semibold text-coral'
							>
								{links[0].text} <span class='sr-only'>for {name}</span>
								<span aria-hidden='true'>→</span>
								<span class='sr-only'>(opens in new tab)</span>
							</a>
						)}
					</div>
				</article>
			))}
		</div>
	</div>
</Section>
