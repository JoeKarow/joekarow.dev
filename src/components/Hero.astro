---
import { Image } from 'astro:assets'
import type { HeroProps } from '@types'

type Props = HeroProps

const { status, greeting, headline, summary, image } = Astro.props
---

<section
	class='grid items-center gap-12 px-4 pt-10 pb-16 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:px-14 md:pt-[72px] md:pb-20'
	id='hero'
	aria-labelledby='hero-heading'
>
	<div>
		<p class='inline-flex items-center gap-2 rounded-full bg-surface-2 px-3.5 py-2 text-sm font-medium'>
			<span
				class='size-2 shrink-0 rounded-full bg-status'
				aria-hidden='true'
			></span>
			{status}
		</p>
		<h1
			id='hero-heading'
			class='mt-7 text-[clamp(3rem,8vw,5.5rem)] leading-[.98] font-semibold tracking-[-0.035em]'
		>
			{greeting}
			<br />
			<span class='text-coral'>{headline}</span>
		</h1>
		<p class='mt-7 max-w-[600px] text-lg leading-[1.55] text-pretty text-ink-muted md:text-[19px]'>
			{summary}
		</p>
	</div>
	<div
		class='mx-auto flex aspect-square w-full max-w-sm rotate-3 items-end justify-center overflow-hidden rounded-[40px] bg-coral md:max-w-none'
		aria-hidden='true'
	>
		<Image class='mb-[6%] w-4/5' src={image} width='400' height='400' alt='' />
	</div>
</section>
