---
import Menu from '@icons/Menu.astro'
import { Image } from 'astro:assets'
import type { HeaderProps } from '@types'

type Props = HeaderProps

const { author, email, siteLogo, navLinks } = Astro.props
---

<header class='sticky top-0 z-50 bg-bg'>
	<div class='relative mx-auto flex max-w-[1200px] items-center justify-between gap-4 px-4 py-4 md:px-14 md:py-[22px]'>
		<a
			href='/'
			class='flex items-center gap-3 text-base font-semibold hover:no-underline'
		>
			<Image
				class='size-10 rounded-full bg-surface-2 object-cover'
				src={siteLogo}
				width='40'
				height='40'
				alt=''
			/>
			<span class='max-[359px]:sr-only'>{author}</span>
		</a>

		<nav
			class='absolute top-full right-4 hidden rounded-2xl border border-line bg-surface p-2 md:static md:border-0 md:block md:rounded-full md:p-1.5'
			id='main-menu'
			aria-label='Primary navigation'
		>
			<ul class='flex flex-col gap-1.5 md:flex-row'>
				{navLinks.map((link) => (
					<li>
						<a
							class='nav-item block rounded-full px-4 py-2 text-[15px] text-ink-muted transition-colors hover:text-ink'
							href={link.href}
						>
							{link.text}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class='flex items-center gap-2'>
			<a
				href={`mailto:${email}`}
				class='rounded-full bg-coral px-5 py-[11px] text-[15px] font-semibold whitespace-nowrap text-bg'
			>
				Say hello
			</a>
			<button
				type='button'
				id='menu-button'
				class='rounded-full p-2.5 text-ink-muted hover:text-ink md:hidden'
				aria-expanded='false'
				aria-controls='main-menu'
				aria-label='Open navigation menu'
			>
				<Menu />
			</button>
		</div>
	</div>
</header>

<script>
	// Toggle mobile menu
	const button = document.querySelector('#menu-button')
	const menu = document.querySelector('#main-menu')
	const navItems = document.querySelectorAll('#main-menu a')

	const setMenuOpen = (isOpen: boolean) => {
		menu?.classList.toggle('hidden', !isOpen)
		button?.setAttribute('aria-expanded', `${isOpen}`)
		button?.setAttribute(
			'aria-label',
			isOpen ? 'Close navigation menu' : 'Open navigation menu',
		)
	}

	const isMenuOpen = () => !(menu?.classList.contains('hidden') ?? true)

	button?.addEventListener('click', () => setMenuOpen(!isMenuOpen()))
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape' || !isMenuOpen()) return
		setMenuOpen(false)
		;(button as HTMLElement | null)?.focus()
	})
	document.addEventListener('click', (event) => {
		const target = event.target as Node
		if (isMenuOpen() && !menu?.contains(target) && !button?.contains(target))
			setMenuOpen(false)
	})

	const setCurrent = (id: string) => {
		navItems.forEach((item) => {
			const isActive = item.getAttribute('href') === `#${id}`
			item.classList.toggle('bg-chip', isActive)
			item.classList.toggle('text-ink', isActive)
			if (isActive) item.setAttribute('aria-current', 'location')
			else item.removeAttribute('aria-current')
		})
	}

	navItems.forEach((item) => {
		item.addEventListener('click', () => {
			setMenuOpen(false)
			setCurrent(item.getAttribute('href')?.slice(1) ?? '')
		})
	})

	// Highlight the nav pill for the section crossing a band near the top of the
	// viewport (high enough that the short final section still reaches it)
	const sections = document.querySelectorAll('main section[id]')
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) setCurrent(entry.target.id)
			})
		},
		{ rootMargin: '-20% 0px -75% 0px' },
	)

	sections.forEach((section) => observer.observe(section))
</script>
