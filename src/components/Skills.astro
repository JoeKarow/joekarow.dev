---
import type { SkillsProps } from '@types'
import Section from './Section.astro'

interface Props {
	skills: SkillsProps
}

const { skills } = Astro.props
---

<Section
	text={skills.title}
	href='skills'
	class='px-4 pt-10 pb-16 md:px-14'
	srOnlyHeading
>
	<div class='grid gap-5 sm:grid-cols-2 lg:grid-cols-3'>
		{skills.categories.map((category) => (
			<div class='flex flex-col gap-3.5 rounded-3xl border border-line p-6'>
				<h3 class='text-[17px] font-semibold'>{category.name}</h3>
				<ul class='flex flex-wrap gap-1.5' role='list'>
					{category.skills.map((skill) => (
						<li class='rounded-full bg-surface-2 px-3 py-1.5 text-sm'>
							{skill}
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
</Section>
